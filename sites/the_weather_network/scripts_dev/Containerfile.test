# Minimal container test image for the the_weather_network site contribution.
# Builds ONLY the_weather_network + the control plane (the real image bundles
# all sites; this one exists to verify this site's container boot semantics:
# instance_seed -> instance copy at boot, seeding no-op, /reset byte-identity,
# /_health payload) without fetching the full HF asset tree for every other
# site.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
    Flask==3.1.0 Flask-SQLAlchemy==3.1.1 \
    Flask-Bcrypt==1.0.1 Flask-WTF==1.2.2 SQLAlchemy==2.0.36 Werkzeug==3.1.3

RUN mkdir -p /opt/WebSyn
COPY sites/the_weather_network /opt/WebSyn/the_weather_network
COPY control_server.py /opt/control_server.py
COPY site_runner.py /opt/site_runner.py
COPY scripts/check_seed_databases.py /opt/check_seed_databases.py

# websyn_start.sh variant that starts only this site at its REAL registry
# slot (40000 + 99 = 40099, per the declared registration index), so the
# control plane's /reset/the_weather_network reaches it on the production
# port.
RUN printf '#!/bin/bash\nset -e\nif [[ ${#WEBSYN_CONTROL_TOKEN} -lt 32 ]]; then echo "token required" >&2; exit 1; fi\nrm -rf /opt/WebSyn/the_weather_network/instance\ncp -a /opt/WebSyn/the_weather_network/instance_seed /opt/WebSyn/the_weather_network/instance\nexec env -u WEBSYN_CONTROL_TOKEN python3 /opt/site_runner.py the_weather_network 40099 > /tmp/websyn_the_weather_network.log 2>&1 &\necho "  the_weather_network -> port 40099"\nsleep 15\nexec env WEBSYN_CONTROL_TOKEN="$WEBSYN_CONTROL_TOKEN" python3 /opt/control_server.py\n' > /opt/websyn_start.sh \
    && chmod +x /opt/websyn_start.sh

EXPOSE 8101 40099
CMD ["/opt/websyn_start.sh"]
