# Minimal container test image for the statista site contribution.
# Builds ONLY the statista site + the control plane (the real image bundles
# all sites; this one exists to verify this site's container boot semantics:
# instance_seed -> instance copy at boot, seeding no-op, /reset byte-identity,
# /_health payload) without fetching the full HF asset tree for every other
# site.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
    Flask==3.1.0 Flask-SQLAlchemy==3.1.1 Flask-Login==0.6.3 \
    Flask-Bcrypt==1.0.1 SQLAlchemy==2.0.36 Werkzeug==3.1.3

RUN mkdir -p /opt/WebSyn
COPY sites/statista /opt/WebSyn/statista
COPY control_server.py /opt/control_server.py
COPY site_runner.py /opt/site_runner.py
COPY scripts/check_seed_databases.py /opt/check_seed_databases.py

# websyn_start.sh variant that starts only this site at its REAL registry
# slot (40000 + 95 = 40095, per the declared registration index), so the
# control plane's /reset/statista reaches it on the production port.
RUN printf '#!/bin/bash\nset -e\nif [[ ${#WEBSYN_CONTROL_TOKEN} -lt 32 ]]; then echo "token required" >&2; exit 1; fi\nrm -rf /opt/WebSyn/statista/instance\ncp -a /opt/WebSyn/statista/instance_seed /opt/WebSyn/statista/instance\nexec env -u WEBSYN_CONTROL_TOKEN python3 /opt/site_runner.py statista 40095 > /tmp/websyn_statista.log 2>&1 &\necho "  statista -> port 40095"\nsleep 12\nexec env WEBSYN_CONTROL_TOKEN="$WEBSYN_CONTROL_TOKEN" python3 /opt/control_server.py\n' > /opt/websyn_start.sh \
    && chmod +x /opt/websyn_start.sh

EXPOSE 8101 40095
CMD ["/opt/websyn_start.sh"]
