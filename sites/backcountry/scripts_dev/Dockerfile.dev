# Single-site dev image for the backcountry mirror — replicates the exact
# real-Dockerfile backcountry block (asset inventory gate + deterministic
# seed build) on the pinned runtime, with the control plane for /reset.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/WebSyn

COPY requirements.lock /opt/requirements.lock
RUN pip3 install --no-cache-dir -r /opt/requirements.lock

COPY sites/backcountry /opt/WebSyn/backcountry
COPY control_server.py /opt/control_server.py
COPY site_runner.py /opt/site_runner.py
COPY scripts/check_asset_inventory.py /opt/check_asset_inventory.py
COPY scripts/check_seed_databases.py /opt/check_seed_databases.py

# Backcountry validates its downloaded product/campaign/review media against
# the tracked inventory and rebuilds its deterministic SQLite seed from
# tracked upstream snapshot data (captured 2026-09-30; see
# sites/backcountry/provenance.json). Byte-identical to the full image block.
RUN python3 /opt/check_asset_inventory.py /opt/WebSyn/backcountry && \
    (cd /opt/WebSyn/backcountry && rm -rf instance instance_seed && PYTHONHASHSEED=0 python3 seed_data.py && mkdir -p instance_seed && cp instance/backcountry.db instance_seed/backcountry.db && rm -rf instance __pycache__)

RUN python3 /opt/check_seed_databases.py /opt/WebSyn

# single-site control plane: keep only backcountry in SITES at its registry
# port 40116 (BASE_PORT 40000 + index 116), matching the full image layout
RUN python3 - << 'EOF'
import re
src = open('/opt/control_server.py').read()
m = re.search(r"SITES = \[(.*?)\]", src, re.S)
src = src.replace(m.group(0), "SITES = ['backcountry']")
src = src.replace("BASE_PORT = 40000", "BASE_PORT = 40000  # site index 116 -> 40116")
src = src.replace("def site_port(site: str) -> int:\n    return BASE_PORT + SITES.index(site)",
                  "def site_port(site: str) -> int:\n    return 40000 + 116  # backcountry registry slot")
open('/opt/control_server.py', 'w').write(src)
EOF

RUN printf '#!/bin/bash\nset -e\nif [[ ${#WEBSYN_CONTROL_TOKEN} -lt 32 ]]; then echo "token required" >&2; exit 1; fi\nrm -rf /opt/WebSyn/backcountry/instance\ncp -a /opt/WebSyn/backcountry/instance_seed /opt/WebSyn/backcountry/instance\nenv -u WEBSYN_CONTROL_TOKEN python3 /opt/site_runner.py backcountry 40116 > /tmp/websyn_backcountry.log 2>&1 &\necho "  backcountry -> port 40116"\nsleep 20\nexec env WEBSYN_CONTROL_TOKEN="$WEBSYN_CONTROL_TOKEN" python3 /opt/control_server.py\n' > /opt/websyn_start.sh && chmod +x /opt/websyn_start.sh

EXPOSE 8101 40116
CMD ["/opt/websyn_start.sh"]
